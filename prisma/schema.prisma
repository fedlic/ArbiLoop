generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 商品マスタ (JANコード ↔ ポケカBOX)
model Product {
  id          String   @id @default(cuid())
  janCode     String   @unique @map("jan_code")
  name        String
  nameEn      String?  @map("name_en")
  imageUrl    String?  @map("image_url")
  taxFreePrice Int?    @map("tax_free_price") // 日本免税価格 (JPY)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceCaches PriceCache[]
  localPrices LocalPrice[]

  @@map("products")
}

// 外部価格キャッシュ (eBay / SASOM / Shopee 等)
model PriceCache {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  source    String   // "ebay" | "sasom" | "shopee" | "lazada"
  price     Float
  currency  String   // "USD" | "THB" | "JPY"
  url       String?
  rawData   Json?    @map("raw_data")
  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, source])
  @@index([expiresAt])
  @@map("price_caches")
}

// 為替レート (1日1回バッチ)
model ExchangeRate {
  id       String   @id @default(cuid())
  base     String   // "JPY"
  target   String   // "USD" | "THB"
  rate     Float
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([base, target])
  @@map("exchange_rates")
}

// 現地価格 (遠征時に投稿)
model LocalPrice {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  price     Float
  currency  String   // "THB" | "PHP" | "USD"
  country   String   // "TH" | "PH" | "US"
  shopName  String?  @map("shop_name")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("local_prices")
}
